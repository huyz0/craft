[Unit]
Description=Craft Factory Codex runner
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=craft-runner
Group=craft-runner
StateDirectory=craft-factory-runner
StateDirectoryMode=0700
WorkingDirectory=/var/lib/craft-factory-runner
EnvironmentFile=/etc/craft-factory/runner.env
EnvironmentFile=-/etc/craft-factory/secrets/runner.env
LoadCredential=CRAFT_FACTORY_RUNNER_TOKEN
ExecStart=/opt/craft-factory/craft-factory run-shared-loop --queue ${CRAFT_FACTORY_QUEUE_URL} --ca /etc/craft-factory/runner/queue-ca.pem --repository-map /etc/craft-factory/runner/repository-map.json --attempt-root /var/lib/craft-factory-runner/attempts --codex /usr/local/bin/codex --codex-home /var/lib/craft-factory-runner/codex-home
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=16min
UMask=0077

[Install]
WantedBy=multi-user.target
